APP_ENV=development
# SQLite for quick local dev; use PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/nyumbani_finder
DATABASE_URL=sqlite:///./nyumbani.db

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=10080

# Pricing (KES) - placeholders, validate with real users
LISTING_FEE=250
UNLOCK_FEE=30
LISTING_EXPIRY_DAYS=30
FLAGS_BEFORE_REVIEW=3

# M-Pesa Daraja. Leave blank to run in MOCK mode (no real money moves).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=https://your-domain.com
MPESA_CALLBACK_SECRET=change_me_too

UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173

# Photo storage - REQUIRED in production (Render wipes local disk on each deploy)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mock payments are blocked when APP_ENV=production unless you explicitly allow them (testing only!)
ALLOW_MOCK_PAYMENTS=false

# Optional: create/promote the first admin on startup (use a strong password, remove after first login if you like)
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
