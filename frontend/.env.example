# URL of the FastAPI backend (no trailing slash). On Render: https://nyumbani-api.onrender.com
VITE_API_URL=http://localhost:8000

# Optional: custom map tiles (e.g. MapTiler/Stadia for heavy traffic). Default is OpenStreetMap.
# VITE_MAP_TILES_URL=https://tiles.example.com/{z}/{x}/{y}.png
# Set to "true" if your tiles are already dark, so the dark filter is skipped.
# VITE_MAP_TILES_DARK=true
